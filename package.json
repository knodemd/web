{
  "name": "knode-web",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/handbook.mjs && node scripts/docs.mjs && vite",
    "build": "node scripts/handbook.mjs && node scripts/docs.mjs && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "format": "prettier --write .",
    "handbook": "node scripts/handbook.mjs",
    "docs": "node scripts/docs.mjs"
  },
  "dependencies": {
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "prettier": "3.8.3",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.2",
    "vite": "8.0.8"
  }
}
